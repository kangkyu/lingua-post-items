// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int   @id @default(autoincrement())
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  translations Translation[]
  bookmarks   Bookmark[]
  sessions    Session[]
  comments    Comment[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

/// A source text: one book, essay or article in its original language.
model Work {
  id        Int      @id @default(autoincrement())
  title     String
  language  String   @default("en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  passages Passage[]

  @@unique([title, language])
  @@map("works")
}

/// One sentence or paragraph of a Work, in the original language. A passage
/// exists whether or not anyone has translated it yet, which is what makes an
/// untranslated chapter something the app can hold.
model Passage {
  id         Int      @id @default(autoincrement())
  text       String
  position   Int
  chapter    String?
  pageNumber Int?     @map("page_number")
  context    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  workId       Int  @map("work_id")
  work         Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  translations Translation[]

  @@unique([workId, position])
  @@index([workId])
  @@map("passages")
}

/// One person's rendering of one Passage. Several may exist for the same
/// passage and language -- that is the point, not a conflict.
model Translation {
  id             Int      @id @default(autoincrement())
  text           String
  targetLanguage String   @map("target_language")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  passageId    Int     @map("passage_id")
  passage      Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  translatorId Int     @map("translator_id")
  translator   User    @relation(fields: [translatorId], references: [id], onDelete: Cascade)
  bookmarks    Bookmark[]
  comments     Comment[]

  @@index([passageId])
  @@map("translations")
}

model Bookmark {
  id        Int   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  userId        Int @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  translationId Int         @map("translation_id")
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@unique([userId, translationId])
  @@map("bookmarks")
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId        Int         @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  translationId Int         @map("translation_id")
  translation   Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@map("comments")
}
